String SRC   = 'CERMAT – Jednotná přijímací zkouška 2025, 1. řádný termín (M9A)';
String STYPE = 'CERMAT';

public class C {
  Map<String,Id> tx; Set<String> have; String src; String stype; public Integer created=0;
  C(Map<String,Id> tx, Set<String> have, String src, String stype){this.tx=tx;this.have=have;this.src=src;this.stype=stype;}
  Id sv(String t,String fn,String s){ContentVersion cv=new ContentVersion(Title=t,PathOnClient=fn,VersionData=Blob.valueOf(s),Origin='H');insert cv;return [SELECT ContentDocumentId FROM ContentVersion WHERE Id=:cv.Id].ContentDocumentId;}
  void lk(Id d,Id r){try{insert new ContentDocumentLink(ContentDocumentId=d,LinkedEntityId=r,ShareType='V',Visibility='AllUsers');}catch(Exception e){insert new ContentDocumentLink(ContentDocumentId=d,LinkedEntityId=r,ShareType='V',Visibility='InternalUsers');}}
  String para(String t){return '{"type":"paragraph","text":'+JSON.serialize(t)+'}';}
  String content(List<String> zad, Id d, String alt, String cap, List<String> opts, Integer ln){
    String s='{"schemaVersion":1,"blocks":[';
    for(Integer i=0;i<zad.size();i++){if(i>0)s+=',';s+=para(zad[i]);}
    if(d!=null){s+=',{"type":"image","contentDocumentId":"'+d+'","alt":'+JSON.serialize(alt)+',"caption":'+JSON.serialize(cap)+',"widthPercent":75,"align":"center"}';}
    if(opts!=null && !opts.isEmpty()){s+=',{"type":"list","items":[';for(Integer i=0;i<opts.size();i++){if(i>0)s+=',';s+=JSON.serialize(opts[i]);}s+=']}';}
    if(ln!=null && ln>0){s+=',{"type":"answerSpace","lines":'+ln+'}';}
    s+=']}';return s;
  }
  String solution(List<String> ps){String s='{"schemaVersion":1,"blocks":[';for(Integer i=0;i<ps.size();i++){if(i>0)s+=',';s+=para(ps[i]);}s+=']}';return s;}
  void add(String name,List<String> zad,List<String> opts,Integer ln,String svg,String fn,String alt,String cap,List<String> solp,String ans,Decimal pts,Decimal mins,String diff,List<String> codes,String ccode,Integer yr){
    if(have.contains(name))return;
    Id d=(svg!=null)?sv(name,fn,svg):null;
    Math_Problem__c mp=new Math_Problem__c(Name=name,Status__c='Publikováno',Visibility__c='Organizace',Language__c='cs',Current_Version_Number__c=1);insert mp;
    String cj=content(zad,d,alt,cap,opts,ln); String sj=solution(solp);
    String aj=JSON.serialize(new Map<String,Object>{'type'=>'Text','value'=>ans});
    Problem_Version__c pub=new Problem_Version__c(Problem__c=mp.Id,Version_Number__c=1,Is_Published__c=true,Published_At__c=Datetime.now(),Title__c=name,Content_JSON__c=cj,Solution_JSON__c=sj,Answer_JSON__c=aj,Answer_Type__c='Text',Points__c=pts,Expected_Time_Min__c=mins,Difficulty__c=diff,Source__c=src,Source_Type__c=stype,License__c='Jiná',CERMAT_Code__c=ccode,Source_Year__c=yr,Search_Text__c=GoMathContent.buildSearchText(name,cj,sj,null));
    insert pub;
    List<Problem_Taxon__c> ls=new List<Problem_Taxon__c>();
    for(String code:codes){Id ti=tx.get(code);if(ti==null)continue;ls.add(new Problem_Taxon__c(Problem_Version__c=pub.Id,Taxon__c=ti,Unique_Key__c=pub.Id+'_'+ti));}
    if(!ls.isEmpty())insert ls;
    if(d!=null)lk(d,mp.Id);
    created++;
  }
}
Map<String,Id> tx=new Map<String,Id>();
for(Taxon__c t:[SELECT Id,Code__c FROM Taxon__c])tx.put(t.Code__c,t.Id);
Set<String> have=new Set<String>();
for(Math_Problem__c p:[SELECT Name FROM Math_Problem__c])have.add(p.Name);
C c=new C(tx,have,SRC,STYPE);

c.add(
  'CERMAT 2025 M9A · úloha 16',
  new List<String>{'Vytváříme tmavé a světlé obrazce tvaru čtverce: bílý čtverec obklopený pásem shodných obdélníčků $2\\ \\mathrm{cm}\\times3\\ \\mathrm{cm}$. U tmavých obrazců je pás užší, u světlých širší. Obrazec popisujeme třemi čísly: počet obdélníčků, délka strany bílého čtverce, délka strany celého obrazce (např. tmavé $4,1,5$ a $8,4,8$; světlý $8,1,7$).','16.1 Délka strany tmavého obrazce je $20\\ \\mathrm{cm}$. Určete počet obdélníčků.','16.2 Délka strany tmavého i světlého obrazce je $23\\ \\mathrm{cm}$. Určete, o kolik se liší počet obdélníčků v těchto dvou obrazcích.','16.3 Tmavý i světlý obrazec mají stejný počet obdélníčků, ale délky stran bílých čtverců se liší o $10\\ \\mathrm{cm}$. Určete počet obdélníčků v tmavém obrazci.'},
  null,
  null,
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 746 156"><path d="M4 4L5 4L5 20L4 20Z" style="fill:#000000"/><path d="M4 20L5 20L5 39L4 39Z" style="fill:#000000"/><path d="M4 39L5 39L5 55L4 55Z" style="fill:#000000"/><path d="M4 55L5 55L5 152L4 152Z" style="fill:#000000"/><path d="M16 65L33 65L33 76L16 76Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M33 65L45 65L45 82L33 82Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M28 82L45 82L45 93L28 93Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M16 76L28 76L28 93L16 93Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M56 65L73 65L73 76L56 76Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M73 65L90 65L90 76L73 76Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M90 65L101 65L101 82L90 82Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M90 82L101 82L101 99L90 99Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M85 99L102 99L102 110L85 110Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M67 99L84 99L84 110L67 110Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M56 93L67 93L67 110L56 110Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M56 76L67 76L67 93L56 93Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M113 65L130 65L130 76L113 76Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M130 65L147 65L147 76L130 76Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M147 65L164 65L164 76L147 76Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M164 65L175 65L175 82L164 82Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M164 82L175 82L175 99L164 99Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M164 99L175 99L175 116L164 116Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M113 93L124 93L124 110L113 110Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M113 76L124 76L124 93L113 93Z" style="fill:#a6a6a6;stroke:#000000;stroke-width:2"/><path d="M181 126L181 65C181 65 181 65 181 65C181 65 181 65 181 65L181 126C181 126 181 127 181 127C181 127 181 126 181 126M178 120L181 127L184 120C184 120 184 120 184 120C183 120 183 120 183 120L181 126L181 126L179 120C179 120 178 120 178 120C178 120 178 120 178 120M184 71L181 65L178 71C178 71 178 71 178 71C178 72 179 71 179 71L181 65L181 65L183 71C183 71 183 72 184 71C184 71 184 71 184 71Z" style="fill:#000000"/><path d="M163 104L125 104C125 104 125 104 125 104C125 104 125 105 125 105L163 105C163 105 164 104 164 104C164 104 163 104 163 104M157 107L164 104L157 102C157 102 157 102 157 102C157 102 157 102 157 102L163 105L163 104L157 107C157 107 157 107 157 107C157 107 157 107 157 107M131 102L124 104L131 107C131 107 131 107 131 107C131 107 131 107 131 107L125 104L125 105L131 102C131 102 131 102 131 102C131 102 131 102 131 102Z" style="fill:#000000"/><path d="M243 65L255 65L255 82L243 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M255 65L266 65L266 82L255 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M266 65L283 65L283 76L266 76Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M266 76L283 76L283 87L266 87Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M272 87L283 87L283 104L272 104Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M260 87L272 87L272 104L260 104Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M243 93L260 93L260 104L243 104Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M243 82L260 82L260 93L243 93Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M294 65L306 65L306 82L294 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M306 65L317 65L317 82L306 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M317 65L328 65L328 82L317 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M328 65L345 65L345 76L328 76Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M328 76L345 76L345 87L328 87Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M328 87L345 87L345 99L328 99Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M334 99L345 99L345 116L334 116Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M323 99L334 99L334 116L323 116Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M311 99L323 99L323 116L311 116Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M294 93L311 93L311 104L294 104Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M294 82L311 82L311 93L294 93Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M357 65L368 65L368 82L357 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M368 65L379 65L379 82L368 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M379 65L391 65L391 82L379 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M391 65L402 65L402 82L391 82Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M402 65L419 65L419 76L402 76Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M402 76L419 76L419 87L402 87Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M402 87L419 87L419 99L402 99Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M402 99L419 99L419 110L402 110Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M357 93L374 93L374 104L357 104Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><path d="M357 82L374 82L374 93L357 93Z" style="fill:#f2f2f2;stroke:#000000;stroke-width:2"/><text x="148" y="17" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">obdélníčků. Každý obdélníček má rozměry 2 cm a 3 cm.</text><text x="225" y="36" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">Obdélníčky jsou buď tmavé (na obrázku vlevo), nebo světlé (na obrázku vpravo) a jsou</text><text x="226" y="52" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">natočeny tak, že pás z tmavých obdélníčků je vždy užší než pás ze světlých obdélníčků.</text><text x="145" y="102" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">7 cm</text><text x="200" y="102" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">11 cm</text></svg>',
  'obr.svg',
  'Tmavé a světlé čtvercové obrazce: bílý čtverec obklopený pásem obdélníčků 2×3 cm, tmavý pás užší, světlý širší.',
  '',
  new List<String>{'Počet obdélníčků $=\\frac{(\\text{strana obrazce})^2-(\\text{strana bílého čtverce})^2}{6}$. U tmavého je strana obrazce o $4$ větší než bílý čtverec, u světlého o $6$.','16.1: bílý $20-4=16$; počet $\\frac{20^2-16^2}{6}=\\frac{144}{6}=24$.','16.2: tmavý bílý $19$, počet $\\frac{23^2-19^2}{6}=28$; světlý bílý $17$, počet $\\frac{23^2-17^2}{6}=40$; rozdíl $12$.','16.3: tmavý bílý $b_t$, světlý $b_s$, $b_t-b_s=10$ a stejný počet dává $b_t=25$; počet $\\frac{29^2-25^2}{6}=36$.'},
  '16.1: $24$ obdélníčků; 16.2: o $12$ obdélníčků; 16.3: $36$ obdélníčků',
  4, 7, '4',
  new List<String>{'zs2','r9','posloupnosti','geometrie','argumentace','pocetni','bez-kalkulacky','bez-kontextu'},
  'M9PAD25C0T01', 2025
);

