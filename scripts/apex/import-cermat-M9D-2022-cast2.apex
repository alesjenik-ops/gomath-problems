9 109C159 109 159 108 160 108C160 108 160 109 160 109M160 112L160 112C160 113 160 113 160 113C159 113 159 113 159 112C159 112 159 111 160 111C160 111 160 112 160 112M160 115L160 115C160 116 160 116 160 116C159 116 159 116 159 115C159 115 159 114 160 114C160 114 160 115 160 115M160 118L160 118C160 119 160 119 160 119C159 119 159 119 159 118C159 118 159 117 160 117C160 117 160 118 160 118M163 119L160 125L157 119L163 119Z" style="fill:#000000"/><path d="M159 125L159 125C159 125 159 125 160 125C160 125 160 125 160 125C160 124 160 124 160 124C159 124 159 124 159 125M159 128L159 128C159 128 159 128 160 128C160 128 160 128 160 128C160 127 160 127 160 127C159 127 159 127 159 128M159 131L159 131C159 131 159 131 160 131C160 131 160 131 160 131C160 130 160 130 160 130C159 130 159 130 159 131M159 134L159 134C159 134 159 134 160 134C160 134 160 134 160 134C160 133 160 133 160 133C159 133 159 133 159 134M159 137L159 137C159 137 159 137 160 137C160 137 160 137 160 137C160 136 160 136 160 136C159 136 159 136 159 137M159 140L159 140C159 140 159 140 160 140C160 140 160 140 160 140L160 140C160 139 160 139 160 139C159 139 159 139 159 140M159 143L159 143C159 143 159 143 160 143C160 143 160 143 160 143C160 142 160 142 160 142C159 142 159 142 159 143M159 146L159 146C159 146 159 146 160 146C160 146 160 146 160 146C160 145 160 145 160 145C159 145 159 145 159 146M159 149L159 149C159 149 159 149 160 149C160 149 160 149 160 149C160 148 160 148 160 148C159 148 159 148 159 149M159 152L159 152C159 152 159 152 160 152C160 152 160 152 160 152C160 151 160 151 160 151C159 151 159 151 159 152M159 155L159 155C159 155 159 155 160 155C160 155 160 155 160 155C160 154 160 154 160 154C159 154 159 154 159 155M159 158L159 158C159 158 159 158 160 158C160 158 160 158 160 158L160 158C160 157 160 157 160 157C159 157 159 157 159 158M157 157L160 163L163 157L157 157Z" style="fill:#000000"/><text x="74" y="177" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">nádvoří</text><text x="56" y="126" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">1. odpočívadlo</text><text x="56" y="83" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">2. odpočívadlo</text><text x="78" y="57" font-size="12" fill="#000" text-anchor="middle" font-family="sans-serif">ochoz</text></svg>',
  'obr.svg',
  'Schéma věže: schodiště nahoru na ochoz (80 vyšších schodů) a schodiště dolů na nádvoří (96 nižších schodů), obě propojena v úrovni 1. a 2. odpočívadla.',
  '',
  new List<String>{'Jeden schod nahoru překoná $\\frac{1}{80}$ výšky věže, jeden schod dolů $\\frac{1}{96}$ výšky.','7.1: Václav vyšel $60$ z $80$ schodů, 2. odpočívadlo je tedy ve výšce $\\frac{60}{80}=\\frac{3}{4}$ výšky. Z ochozu k němu klesneme o $\\frac{1}{4}$ výšky, tj. $\\frac{1}{4}\\cdot96=24$ schodů dolů.','7.2: 1. odpočívadlo je o $30$ nižších schodů níže, tj. o $\\frac{30}{96}=\\frac{5}{16}$ výšky; je ve výšce $\\frac{3}{4}-\\frac{5}{16}=\\frac{7}{16}$ výšky. Eva vyšla nahoru $\\frac{7}{16}\\cdot80=35$ schodů.'},
  '7.1: $24$ schodů; 7.2: $35$ schodů',
  4, 7, '4',
  new List<String>{'zs2','r9','slovni','pomer','uvazovani','bez-kalkulacky','bezny-zivot'},
  'M9PDD22C0T04', 2022
);

System.debug('Vytvořeno úloh: '+c.created);
